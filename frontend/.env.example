# Скопіюй у .env.local для локальної розробки.
# На Vercel додай ці ж змінні в Project Settings -> Environment Variables.

VITE_API_BASE_URL=http://localhost:8000

# Для завантаження фото з галереї в адмінці (Cloudinary, безкоштовно)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name
