# Скопіюй у .env локально, а на Vercel додай ці ж змінні
# в Project Settings -> Environment Variables

# Neon: бери саме "Pooled connection" рядок з дашборду Neon
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Придумай будь-який довгий випадковий рядок — це твій пароль до адмінських ендпоінтів
ADMIN_API_KEY=change-me-to-a-long-random-string

# Ключ Gemini API — отримати на https://aistudio.google.com/apikey (безкоштовно)
GEMINI_API_KEY=your-gemini-api-key

# Будь-який випадковий рядок для хешування IP у анти-спам захисті
IP_HASH_SALT=another-random-string
